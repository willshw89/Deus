# Whitelist: the project root is also the Dwarf Fortress install and holds the U7 installs.
# Ignore everything at the root, then allow only our own files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/docs/
!/game/
!/tools/
!/art/
!/launch_demo.bat
!/open_in_rmmz.bat
!/run_autotest.bat
!/run_tests.bat

# Generated by test runs
/game/game_runtime.log
/game/test_screenshot.png
/game/test_output/
/game/save/

# U7 stand-ins (AGENTS.md rule 8): any file starting with U7_ / $U7_ / !$U7_ / u7_ anywhere under game/img
/game/img/**/U7_*
/game/img/**/$U7_*
/game/img/**/!$U7_*
/game/img/**/u7_*

# U7/DF-derived content from the earlier session: never commit (docs/STATUS.md → Stand-ins)
/game/img/characters/$U7_*
/game/img/characters/!$U7_*
/game/img/characters/actor_*.png
/game/img/characters/monster_*.png
/game/img/characters/test_shape*.png
/game/img/system/u7_gumps/
/game/img/system/u7_gump_*.png
/game/img/system/gump_*.png
/game/img/system/paperdoll_*.png
/game/img/faces/face_*.png
/game/img/faces/U7_Faces.png
/game/img/tilesets/U7_Fortress_B.png
/game/data/df_*.json
# Rebuilt from U7 SHAPES.VGA by Gemini on 2026-09-18 (AUDIT_LOG A1-1). Remove these lines once replaced with original art.
/game/img/characters/$Adam.png
/game/img/characters/$Eve.png
# U7-derived stand-in committed by mistake in 1a6fff5 (AUDIT_LOG A3-4); untracked 2026-09-18. Purge from history before any public push.
/game/img/characters/!$FruitTree.png
# U7-derived copies under non-prefixed names, made by tools/generate_all_u7_assets.js (2026-09-18). The U7_ copies are what the game uses.
/game/img/characters/!$CaveMouth.png
/game/img/characters/!$CaveLadder.png
/game/img/characters/!$IronOreVein.png
/game/img/characters/!$TreeStump.png
/game/img/characters/$People1.png
# Backups of the U7-derived originals kept beside their stock replacements ($Adam.u7bak.png, $Eve.u7bak.png; stock-swap run 2026-09-19). AGENTS rule 8: never commit.
*.u7bak.png

