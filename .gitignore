# Whitelist: the project root is also the Dwarf Fortress install and holds the U7 installs.
# Ignore everything at the root, then allow only our own files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/docs/
!/game/
!/tools/
!/art/
!/archive/
!/.agents/
!/tasks/
!/prompts/
!/baseline/
!/launch_demo.bat
!/open_in_rmmz.bat
!/run_autotest.bat
!/run_tests.bat
!/Deus.exe

# Generated by test runs
/game/game_runtime.log
/game/game_error.log
/game/test_screenshot.png
/game/test_output/
/game/save/
/art/review/

# Art staging, sprites scratch, and tileset scratch
/art/staging/
/art/tilesets/
/art/sprites/

# Temporary test harnesses and experimental UI assets
/game/img/system/ui_open_sack*.png
/tools/capture_sack_ui_playtest.js
/tools/test_sack_ui_and_loose_items.js

# Reconstructed art prompts and scratch templates
/art/prompts/*.json
!/art/prompts/SURFACE_SHARED_STONE_GRANITE-BOULDER_V1_DEFAULT.json
/art/templates/*
!/art/templates/README.md

# Local art generation and inspection tooling
!/tools/art/assemble_batch_10_items.js
!/tools/art/assemble_racial_banners.js
!/tools/art/assemble_v8_sheet.js
!/tools/art/build_catalogue.js
!/tools/art/make_blank_templates.js
!/tools/art/place_art.js
!/tools/art/test_blank_templates.js
!/tools/art/test_catalogue.js
!/tools/art/test_multi_variant_topology.js
!/tools/art/test_place_art.js
!/tools/art/test_validate_asset_standard.js
!/tools/art/validate_art.js
!/tools/art/validate_asset_standard.js

# Temporary task execution outputs and local prompts
/tasks/*.txt




# Protected local files must stay visible to git status (deus-multiagent-routing.md); never hide them.
!/tasks/prompt_cline_minimax.txt
# Secrets never enter the repo.
**/.pixellab_token
**/.env
**/.env.*
/game/*.log

# Live worker telemetry, rewritten by tools/ops/launch_worker.ps1 in main's worktree on every launch and exit.
# Tracked, it made merge_gate refuse with MAIN_DIRTY whenever a worker started or ended mid-run (AUDIT_LOG A13-2).
docs/telemetry/sessions/active_workers.json
docs/telemetry/sessions/provider_status.json

# Agent mail is local files on this machine (PM, AG and the workers share one checkout). Not committed: a mail commit moves main and
# makes merge_gate refuse (MAIN_DIRTY / RACE_REF_MOVED; DEC-085). The README stays tracked.
docs/agents/mailboxes/**/*.jsonl

# Repo organization (WBS-ORG ORG-2.3/2.4, 2026-10-02): CI config and the one-line .clinerules pointer are tracked.
!/.github/
!/.clinerules
# Scratch and generated output (WBS-ORG ORG-2.3). Throwaway scripts go in scratchpad/<lane-id>/.
scratch/
scratchpad/
tmp/
temp_*
test_wang*
*.log
test_output/
game/error_stack.txt
