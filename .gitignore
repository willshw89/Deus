# Whitelist: the project root is also the Dwarf Fortress install and holds the U7 installs.
# Ignore everything at the root, then allow only our own files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/docs/
!/game/
!/tools/
!/art/
!/archive/
!/.agents/
!/tasks/
!/prompts/
!/baseline/
!/launch_demo.bat
!/open_in_rmmz.bat
!/run_autotest.bat
!/run_tests.bat
!/Deus.exe

# Generated by test runs
/game/game_runtime.log
/game/game_error.log
/game/test_screenshot.png
/game/test_output/
/game/save/
/art/review/


